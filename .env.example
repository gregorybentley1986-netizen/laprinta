# Пароль входа в /admin. В production обязателен; в dev без него используется "laprinta".
ADMIN_PASSWORD=change-me

# Секрет подписи cookie-сессии админки (любая длинная случайная строка).
# Если не задан — используется ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Каталог данных: db.json и загруженные медиа (uploads/). По умолчанию ./storage
# DATA_DIR=/var/laprinta

# Публичный адрес сайта (для canonical / Open Graph)
NEXT_PUBLIC_SITE_URL=https://laprinta.ru
